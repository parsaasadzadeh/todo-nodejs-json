<form action="/add" method="POST" class="relative">
    <div class="relative flex items-center">
        <input type="text" name="todoText" required placeholder="What needs to be done?"
            class="w-full bg-slate-900/50 border border-slate-700 text-white placeholder-slate-500 text-sm rounded-xl py-4 pl-4 pr-32 focus:outline-none focus:border-pink-500/50 focus:ring-1 focus:ring-pink-500/50 transition-all shadow-inner">

        <button type="submit"
            class="absolute right-2 top-2 bottom-2 bg-gradient-to-r from-pink-500 to-purple-600 hover:from-pink-400 hover:to-purple-500 text-white px-6 rounded-lg font-bold text-sm shadow-lg shadow-purple-500/30 transition-all transform hover:-translate-y-0.5 active:translate-y-0">
            Add Task
        </button>
    </div>
</form>